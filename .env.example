# Copiaza in .env local si completeaza. NU comita .env cu valori reale.
# In productie se seteaza in Vercel > Project Settings > Environment Variables.

# Supabase (public, expus in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Supabase service role (SECRET, doar server-side / functii Vercel)
SUPABASE_SERVICE_ROLE=

# Google Gemini (folosit prin vite.config.ts define)
GEMINI_API_KEY=

# Vercel Blob (api/upload.ts)
BLOB_READ_WRITE_TOKEN=

# Meta Conversions API (api/meta-conversion.js)
META_PIXEL_ID=
META_ACCESS_TOKEN=
